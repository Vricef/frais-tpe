# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase — fichiers de configuration sensibles (spécifiques à chaque environnement)
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Variables d'environnement / secrets
.env
.env.*
*.env

# Clés de compte de service Firebase (import des grilles tarifaires) —
# elles donnent un accès administrateur complet au projet.
cle-service.json
*-service-account*.json
serviceAccountKey*.json
firebase-adminsdk*.json

# Dépendances du script d'import
# npm ne tourne que dans firestore/. Un node_modules/ ou un
# package-lock.json à la racine vient d'une commande lancée au mauvais
# endroit : sans ces règles, un `git add` y embarque des milliers de
# fichiers de dépendances.
node_modules/
/package-lock.json

# Harnais de prévisualisation local (screenshots de mise au point UI)
lib/_preview.dart

# Signature Android : le magasin de clés et ses mots de passe restent
# hors du dépôt. Les perdre interdit toute mise à jour de l app publiée.
android/key.properties
*.jks
*.keystore
